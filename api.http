@baseUrl = http://localhost:8080
@serverName = src
@jobId = job-1
@tableName = TAG

# =============================================================================
# Servers
# =============================================================================

### 서버 목록 조회
GET {{baseUrl}}/api/servers

###

### 서버 단건 조회
GET {{baseUrl}}/api/servers/{{serverName}}

###

### 서버 헬스체크
GET {{baseUrl}}/api/servers/{{serverName}}/health

###

### 서버 등록
POST {{baseUrl}}/api/servers
Content-Type: application/json

{
  "name": "new-server",
  "host": "192.168.1.183",
  "port": 5656,
  "user": "SYS",
  "password": "MANAGER"
}

###

### 서버 수정
PUT {{baseUrl}}/api/servers/new-server
Content-Type: application/json

{
  "host": "192.168.1.200",
  "port": 5656,
  "user": "SYS",
  "password": "MANAGER"
}

###

### 서버 삭제
DELETE {{baseUrl}}/api/servers/new-server

###

### 테이블 목록 조회
GET {{baseUrl}}/api/servers/{{serverName}}/tables

###

### 테이블 스키마 조회
GET {{baseUrl}}/api/servers/{{serverName}}/tables/{{tableName}}/schema

# =============================================================================
# Jobs
# =============================================================================

### job 목록 조회
GET {{baseUrl}}/api/jobs

###

### job 단건 조회
GET {{baseUrl}}/api/jobs/{{jobId}}

###

### job 생성
POST {{baseUrl}}/api/jobs
Content-Type: application/json

{
  "id": "job-new",
  "source": {
    "server": "src",
    "table": "TAG"
  },
  "target": {
    "server": "dst",
    "table": "TAG2"
  },
  "startMode": "full",
  "pollIntervalMs": 1000,
  "queryLimit": 1000,
  "onSaveFailure": "continue"
}

###

### job 수정
PUT {{baseUrl}}/api/jobs/job-new
Content-Type: application/json

{
  "source": {
    "server": "src",
    "table": "TAG"
  },
  "target": {
    "server": "dst",
    "table": "TAG2"
  },
  "startMode": "now",
  "pollIntervalMs": 2000,
  "queryLimit": 5000,
  "onSaveFailure": "continue"
}

###

### job 시작
POST {{baseUrl}}/api/jobs/{{jobId}}/start

###

### job 중지
POST {{baseUrl}}/api/jobs/{{jobId}}/stop

###

### job 삭제
DELETE {{baseUrl}}/api/jobs/job-new
