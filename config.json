{
  "version": 3,
  "api": { "enabled": true, "port": 8080, "cors": { "origin": "*" } },
  "logging": {
    "level": "info",
    "stdout": false,
    "file": {
      "enabled": true,
      "directory": "./logs"
    }
  },
  "servers": [
    {
      "name": "src",
      "host": "192.168.1.183",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    },
    {
      "name": "dst",
      "host": "192.168.1.183",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    }
  ],
  "replication": {
    "jobs": [
      {
        "id": "job-1",
        "shutdownTimeoutMs": 30000,
        "source": {
          "server": "src",
          "table": "TAG",
          "columns": ["name"]
        },
        "target": {
          "server": "dst",
          "table": "TAG2"
        },
        "queryLimit": 1000,
        "pollIntervalMs": 1000,
        "startMode": "full",
        "onSaveFailure": "continue",
        "integrity": {
          "enabled": true
        }
      }
    ]
  }
}
