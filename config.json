{
  "version": 3,
  "servers": [
    {
      "name": "src",
      "host": "192.168.1.183",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    }
  ],
  "logging": {
    "level": "debug",
    "stdout": true,
    "file": {
      "enabled": true,
      "directory": "/work/logs"
    }
  },
  "api": {
    "enabled": true,
    "port": 8080,
    "cors": {
      "origin": "*"
    }
  },
  "replication": {
    "jobs": [
      {
        "id": "job-1",
        "shutdownTimeoutMs": 30000,
        "source": {
          "server": "src",
          "table": "TAG",
          "columns": ["name", "time", "value"],
          "filter": null,
          "transform": null
        },
        "target": {
          "server": "src",
          "table": "TAG_COPY",
          "autoCreate": true
        },
        "startMode": "full",
        "ridAfter": null,
        "pollIntervalMs": 1000,
        "queryLimit": 5000,
        "ridRangeSize": 50000,
        "onSaveFailure": "continue",
        "integrity": {
          "enabled": true
        },
        "retry": {
          "maxAttempts": 5,
          "baseDelayMs": 100,
          "maxDelayMs": 30000
        }
      }
    ]
  }
}
