{
  "version": 3,
  "servers": {
    "src": {
      "host": "192.168.1.189",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    },
    "dst": {
      "host": "192.168.1.189",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    }
  },
  "replication": {
    "jobs": [
      {
        "id": "job-1",
        "enabled": true,
        "shutdown_timeout_ms": 30000,
        "checkpoint": {
          "directory": "./checkpoints"
        },
        "execution_defaults": {
          "query_limit": 1000,
          "poll_interval_ms": 1000,
          "start_mode": "full",
          "on_save_failure": "continue",
          "integrity": {
            "enabled": true
          }
        },
        "mappings": [
          {
            "mapping_id": "tag-to-tag2",
            "source": {
              "server": "src",
              "table": "TAG"
            },
            "target": {
              "server": "dst",
              "table": "HDCAR"
            }
          }
        ]
      }
    ]
  }
}
