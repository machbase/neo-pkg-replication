{
  "version": 3,
  "api": { "enabled": true, "port": 8080 },
  "logging": {
    "level": "info",
    "stdout": false,
    "file": {
      "enabled": true,
      "directory": "./logs"
    }
  },
  "servers": {
    "src": {
      "host": "192.168.1.183",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    },
    "dst": {
      "host": "192.168.1.183",
      "port": 5656,
      "user": "SYS",
      "password": "MANAGER"
    }
  },
  "replication": {
    "jobs": [
      {
        "id": "job-1",
        "shutdown_timeout_ms": 30000,
        "checkpoint": {
          "directory": "./checkpoints"
        },
        "source": {
          "server": "src",
          "table": "TAG",
          "columns": ["name"]
        },
        "target": {
          "server": "dst",
          "table": "TAG2"
        },
        "execution": {
          "query_limit": 1000,
          "poll_interval_ms": 1000,
          "start_mode": "full",
          "on_save_failure": "continue",
          "integrity": {
            "enabled": true
          }
        }
      }
    ]
  }
}
