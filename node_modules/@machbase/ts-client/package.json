{
  "name": "@machbase/ts-client",
  "version": "0.9.3",
  "description": "Pure TypeScript Machbase client implementing the CMI protocol version 4.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint --ext .ts src",
    "test": "npm run build && node dist/tests/integration.js",
    "smoke": "npm run build && node dist/examples/smoke.js"
  },
  "keywords": [
    "machbase",
    "database",
    "client",
    "typescript"
  ],
  "files": [
    "dist",
    "src/example-js"
  ],
  "author": "Machbase",
  "license": "Proprietary",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/node": "^20.11.30"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0"
  }
}
